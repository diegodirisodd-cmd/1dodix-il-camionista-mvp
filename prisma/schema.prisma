generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Durable webhook inbox. No automatic replies or business actions are run yet.
model WhatsAppWebhookReceipt {
  id            String   @id
  wabaId        String
  phoneNumberId String
  payload       Json
  receivedAt    DateTime @default(now())

  @@index([receivedAt])
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  phone     String?
  role      String   @default("COMPANY")
  createdAt DateTime @default(now())

  // Profilo utente
  firstName     String?
  lastName      String?
  companyName   String?
  vatNumber     String?
  address       String?
  city          String?
  province      String?
  zipCode       String?
  country       String? @default("IT")
  contactPerson String?
  avatarUrl     String?

  companyRequests     Request[] @relation("CompanyRequests")
  transporterRequests Request[] @relation("TransporterJobs")
  requestUnlocks      RequestUnlock[]

  supplierProfile      SupplierProfile?
  serviceRequestsMade  ServiceRequest[]
}

model Request {
  id          Int     @id @default(autoincrement())
  pickup      String
  delivery    String
  cargo       String?
  description String?
  price       Int

  companyId     Int
  transporterId Int?

  contactsUnlocked     Boolean  @default(false)
  unlockedByCompany    Boolean  @default(false)
  unlockedByTransporter Boolean @default(false)

  acceptedAt DateTime?
  status     String   @default("OPEN")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Nuovi campi professionali
  pickupDate    DateTime? 
  deliveryDate  DateTime? 
  cargoType     String?   
  weight        Decimal?  
  volume        String?   
  palletCount   Int?      
  vehicleType   String?   
  isAdr         Boolean   @default(false)
  paymentTerms  String?   
  pickupContact String?   
  pickupPhone   String?   
  distanceKm    Decimal?  

  company     User  @relation("CompanyRequests", fields: [companyId], references: [id])
  transporter User? @relation("TransporterJobs", fields: [transporterId], references: [id])
  unlocks     RequestUnlock[]
}

model RequestUnlock {
  id                    Int      @id @default(autoincrement())
  requestId             Int
  userId                Int
  userRole              String
  amountCents           Int?
  stripeSessionId       String?
  stripePaymentIntentId String?
  paidAt                DateTime @default(now())
  createdAt             DateTime @default(now())

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([requestId, userId])
}

// ─── Borsa Servizi ────────────────────────────────────────────────
// Marketplace di servizi per aziende di trasporto: officine, telonai,
// gommisti, soccorso stradale, carrozzerie, lavaggio mezzi.

model SupplierProfile {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  ragioneSociale String
  partitaIva     String?
  createdAt      DateTime @default(now())

  user  User                   @relation(fields: [userId], references: [id])
  aree  SupplierServiceArea[]
  quotes ServiceQuote[]
  unlocks ServiceContactUnlock[]
}

model SupplierServiceArea {
  id         Int    @id @default(autoincrement())
  supplierId Int
  categoria  String
  provincia  String

  supplier SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, categoria, provincia])
}

model ServiceRequest {
  id            Int       @id @default(autoincrement())
  transporterId Int
  categoria     String
  posizione     String
  provincia     String
  marcaVeicolo  String
  tipoVeicolo   String
  descrizione   String
  urgenza       String
  scadenza      DateTime
  stato         String    @default("APERTA")
  assignedQuoteId Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  transporter User                   @relation(fields: [transporterId], references: [id])
  fotos       ServiceRequestPhoto[]
  quotes      ServiceQuote[]
  unlocks     ServiceContactUnlock[]
}

model ServiceRequestPhoto {
  id        Int      @id @default(autoincrement())
  requestId Int
  url       String
  createdAt DateTime @default(now())

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model ServiceQuote {
  id            Int      @id @default(autoincrement())
  requestId     Int
  supplierId    Int
  priceCents    Int
  tempi         String
  disponibilita String
  createdAt     DateTime @default(now())

  request  ServiceRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  supplier SupplierProfile @relation(fields: [supplierId], references: [id])

  @@unique([requestId, supplierId])
}

model ServiceContactUnlock {
  id                    Int      @id @default(autoincrement())
  requestId             Int
  supplierId            Int
  amountCents           Int?
  stripeSessionId       String?
  stripePaymentIntentId String?
  paidAt                DateTime @default(now())
  createdAt             DateTime @default(now())

  request  ServiceRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  supplier SupplierProfile @relation(fields: [supplierId], references: [id])

  @@unique([requestId, supplierId])
}
