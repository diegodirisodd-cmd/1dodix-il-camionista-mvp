generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Durable webhook inbox. No automatic replies or business actions are run yet.
model WhatsAppWebhookReceipt {
  id            String   @id
  wabaId        String
  phoneNumberId String
  payload       Json
  receivedAt    DateTime @default(now())

  @@index([receivedAt])
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  phone     String?
  role      String   @default("COMPANY")
  createdAt DateTime @default(now())

  // Profilo utente
  firstName     String?
  lastName      String?
  companyName   String?
  vatNumber     String?
  address       String?
  city          String?
  province      String?
  zipCode       String?
  country       String? @default("IT")
  contactPerson String?
  avatarUrl     String?
  whatsappOptIn Boolean @default(false)

  // Profilo operativo del trasportatore: mezzi disponibili e regioni in cui
  // lavora. Servono per la bacheca "Per te" e per gli avvisi WhatsApp mirati.
  vehicleTypes   String[] @default([])
  serviceRegions String[] @default([])
  // P.IVA verificata sul servizio VIES dell'Unione europea.
  vatVerified    Boolean  @default(false)
  vatVerifiedAt  DateTime?

  companyRequests     Request[] @relation("CompanyRequests")
  transporterRequests Request[] @relation("TransporterJobs")
  requestUnlocks      RequestUnlock[]
  applications        Application[]
  messagesSent        Message[]
  reviewsGiven        Review[]  @relation("ReviewAuthor")
  reviewsReceived     Review[]  @relation("ReviewTarget")

  supplierProfile      SupplierProfile?
  serviceRequestsMade  ServiceRequest[]
}

model Request {
  id          Int     @id @default(autoincrement())
  pickup      String
  delivery    String
  cargo       String?
  description String?
  price       Int

  companyId     Int
  transporterId Int?

  contactsUnlocked     Boolean  @default(false)
  unlockedByCompany    Boolean  @default(false)
  unlockedByTransporter Boolean @default(false)

  acceptedAt DateTime?
  status     String   @default("OPEN")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Nuovi campi professionali
  pickupDate    DateTime? 
  deliveryDate  DateTime? 
  cargoType     String?   
  weight        Decimal?  
  volume        String?   
  palletCount   Int?      
  vehicleType   String?   
  isAdr         Boolean   @default(false)
  paymentTerms  String?   
  pickupContact String?   
  pickupPhone   String?   
  distanceKm    Decimal?  

  // Luoghi strutturati (comuni ISTAT). pickup/delivery restano il testo
  // mostrato e usato dagli avvisi WhatsApp.
  pickupCity       String?
  pickupProvince   String?
  pickupRegion     String?
  pickupLat        Float?
  pickupLng        Float?
  deliveryCity     String?
  deliveryProvince String?
  deliveryRegion   String?
  deliveryLat      Float?
  deliveryLng      Float?

  // Ciclo di vita: OPEN -> ASSIGNED (azienda ha scelto e pagato) ->
  // CONFIRMED (ha pagato anche il trasportatore, contatti visibili) ->
  // DELIVERED. In ogni momento prima di CONFIRMED: CANCELLED.
  selectedApplicationId Int?
  agreedPrice           Int?
  assignedAt            DateTime?
  confirmedAt           DateTime?
  deliveredAt           DateTime?
  cancelledAt           DateTime?

  company      User  @relation("CompanyRequests", fields: [companyId], references: [id])
  transporter  User? @relation("TransporterJobs", fields: [transporterId], references: [id])
  unlocks      RequestUnlock[]
  applications Application[]
  reviews      Review[]

  @@index([status, pickupRegion])
}

// Candidatura gratuita di un trasportatore a un carico.
// Stati: PENDING, SELECTED, REJECTED, WITHDRAWN (ritirata dal trasportatore),
// DECLINED (scelto ma ha rinunciato), RELEASED (scelto ma non ha confermato
// in tempo: l'azienda lo ha sostituito).
model Application {
  id            Int       @id @default(autoincrement())
  requestId     Int
  transporterId Int
  priceCents    Int?
  message       String?
  status        String    @default("PENDING")
  selectedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  request     Request   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  transporter User      @relation(fields: [transporterId], references: [id])
  messages    Message[]

  @@unique([requestId, transporterId])
  @@index([transporterId])
}

// Chat interna fra azienda e un candidato. Finche' i contatti non sono
// sbloccati da entrambi, telefoni ed email nei messaggi vengono oscurati.
model Message {
  id            Int       @id @default(autoincrement())
  applicationId Int
  senderId      Int
  body          String
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  sender      User        @relation(fields: [senderId], references: [id])

  @@index([applicationId, createdAt])
}

// Recensione lasciata dopo la consegna, una per autore e carico.
model Review {
  id        Int      @id @default(autoincrement())
  requestId Int
  authorId  Int
  targetId  Int
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author  User    @relation("ReviewAuthor", fields: [authorId], references: [id])
  target  User    @relation("ReviewTarget", fields: [targetId], references: [id])

  @@unique([requestId, authorId])
  @@index([targetId])
}

model RequestUnlock {
  id                    Int      @id @default(autoincrement())
  requestId             Int
  userId                Int
  userRole              String
  amountCents           Int?
  stripeSessionId       String?
  stripePaymentIntentId String?
  paidAt                DateTime @default(now())
  createdAt             DateTime @default(now())

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([requestId, userId])
}

// ─── Borsa Servizi ────────────────────────────────────────────────
// Marketplace di servizi per aziende di trasporto: officine, telonai,
// gommisti, soccorso stradale, carrozzerie, lavaggio mezzi.

model SupplierProfile {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  ragioneSociale String
  partitaIva     String?
  createdAt      DateTime @default(now())

  user  User                   @relation(fields: [userId], references: [id])
  aree  SupplierServiceArea[]
  quotes ServiceQuote[]
  unlocks ServiceContactUnlock[]
}

model SupplierServiceArea {
  id         Int    @id @default(autoincrement())
  supplierId Int
  categoria  String
  provincia  String

  supplier SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, categoria, provincia])
}

model ServiceRequest {
  id            Int       @id @default(autoincrement())
  transporterId Int
  categoria     String
  posizione     String
  provincia     String
  marcaVeicolo  String
  tipoVeicolo   String
  descrizione   String
  urgenza       String
  scadenza      DateTime
  stato         String    @default("APERTA")
  assignedQuoteId Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  transporter User                   @relation(fields: [transporterId], references: [id])
  fotos       ServiceRequestPhoto[]
  quotes      ServiceQuote[]
  unlocks     ServiceContactUnlock[]
}

model ServiceRequestPhoto {
  id        Int      @id @default(autoincrement())
  requestId Int
  url       String
  createdAt DateTime @default(now())

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model ServiceQuote {
  id            Int      @id @default(autoincrement())
  requestId     Int
  supplierId    Int
  priceCents    Int
  tempi         String
  disponibilita String
  createdAt     DateTime @default(now())

  request  ServiceRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  supplier SupplierProfile @relation(fields: [supplierId], references: [id])

  @@unique([requestId, supplierId])
}

model ServiceContactUnlock {
  id                    Int      @id @default(autoincrement())
  requestId             Int
  supplierId            Int
  amountCents           Int?
  stripeSessionId       String?
  stripePaymentIntentId String?
  paidAt                DateTime @default(now())
  createdAt             DateTime @default(now())

  request  ServiceRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  supplier SupplierProfile @relation(fields: [supplierId], references: [id])

  @@unique([requestId, supplierId])
}
