SUPABASE_SERVICE_ROLE_KEY="service-role-key"

# Borsa Servizi – notifiche email ai fornitori (opzionale: senza chiave
# gli invii vengono saltati con un warning, il resto continua a funzionare).
RESEND_API_KEY="re_xxx"
FROM_EMAIL="DodiX <onboarding@resend.dev>"
